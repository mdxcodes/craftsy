# ============================================================
# Craftsy — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed.
# This file holds variable NAMES only — never real keys.
# ============================================================


# ── Backend Core ───────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database (SQLite locally; Railway supplies PostgreSQL URL in production)
DATABASE_URL=sqlite:///./backend/craftsy.db
DATABASE_ECHO=false

# CORS (comma-separated origins; never use * with credentials in production)
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Uploads (defaults to /app/backend/uploads inside Docker)
UPLOAD_DIR=backend/uploads
STATIC_URL_PREFIX=/uploads

# Model warm-up (disable on Railway to avoid cold-start downloads)
WARMUP_MODELS_ENABLED=false

# Background removal model (u2netp = 4 MB, u2net = larger)
REMBG_MODEL=u2netp


# ── LLM Providers ──────────────────────────────────────────────
# Groq Cloud (primary LLM for chat, cataloging, pricing)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq

# Google Gemini (fallback LLM + embeddings + pricing)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001


# ── Voice / Speech-to-Text ─────────────────────────────────────
# Any OpenAI-compatible transcription endpoint works.
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-large-v3
STT_PROVIDER=whisper
DEFAULT_LANGUAGE=hi
SUPPORTED_LANGUAGES=hi,ta,bn,mr,te,gu,kn,ml,pa,or
STT_REQUEST_TIMEOUT=60
STT_RETRY_ATTEMPTS=3
MAX_AUDIO_DURATION_SECONDS=180
GLOSSARY_TERMS_IN_PROMPT=24
# Silence detection threshold in dB. Audio with max_volume below this is rejected.
# Mobile recordings in noisy environments may have max_volume between -40dB and -50dB.
SILENCE_THRESHOLD_DB=-50.0


# ── Bhashini / ULCA Language Services (optional) ────────────
# Uses the ULCA pipeline: config call + compute call.
# Pipeline Config authentication uses BHASHINI_USER_ID + BHASHINI_ULCA_API_KEY.
# Inference authentication uses BHASHINI_INFERENCE_API_KEY (fallback; the
# Pipeline Config response usually supplies the actual inference key dynamically).
# Without credentials, Bhashini endpoints return 503.
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_ULCA_API_KEY=your_bhashini_ulca_api_key
BHASHINI_INFERENCE_API_KEY=your_bhashini_inference_api_key
# Current Bhashini Udyat inference header name
BHASHINI_INFERENCE_API_KEY_NAME=Authorization
# Deprecated: the new ULCA client does not use this value.
# Kept here only for backward compatibility with older code.
BHASHINI_BASE_URL=https://api.bhashini.gov.in


# ── ChromaDB / Pricing Pipeline ────────────────────────────────
# Chroma mode: "cloud" (production/Railway) or "local" (development).
# Local mode uses ML/pricing/chroma_db/ for persistent storage.
CHROMA_MODE=local

# Chroma Cloud credentials (required when CHROMA_MODE=cloud).
# CHROMA_API_KEY=your_chroma_api_key
# CHROMA_TENANT=your_chroma_tenant
# CHROMA_DATABASE=your_chroma_database

# Local ChromaDB path (used only when CHROMA_MODE=local).
CHROMADB_PATH=ML/pricing/chroma_db

# Collection name (same for cloud and local).
CHROMADB_COLLECTION=benchmark_products

# Pricing retrieval parameters.
PRICING_TOP_K=5
PRICING_SIMILARITY_THRESHOLD=0.55


# ── Optional: Supabase (not used by current backend code) ───────
# The current backend uses SQLAlchemy + PostgreSQL/SQLite directly.
# Supabase is NOT required for Craftsy to run.


# ── StartMessaging OTP Service (active) ───────────────────────────
# Get this from the StartMessaging dashboard.
STARTMESSAGING_API_KEY=your_startmessaging_api_key


# ── MSG91 OTP Service (deprecated; kept for historical reference) ───
# These variables are no longer used by the active OTP flow.
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_TEMPLATE_ID=your_msg91_otp_template_id
# MSG91_OTP_EXPIRE_SECONDS=300


# ── Railway (set in Railway dashboard, not in this file) ────────
# DATABASE_URL  — Railway PostgreSQL connection string
# ENVIRONMENT   — production
# CORS_ORIGINS  — your production frontend domain(s)
# GROQ_API_KEY  — if using Groq
# GEMINI_API_KEY — if using Gemini
# WHISPER_API_KEY — if using Whisper STT
# BHASHINI_USER_ID, BHASHINI_ULCA_API_KEY — if using Bhashini
