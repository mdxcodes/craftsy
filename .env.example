# ============================================================
# Craftsy — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed.
# This file holds variable NAMES only — never real keys.
# ============================================================


# ── Backend Core ───────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database (SQLite locally; Railway supplies PostgreSQL URL in production)
DATABASE_URL=sqlite:///./backend/craftsy.db
DATABASE_ECHO=false

# CORS (comma-separated origins; never use * with credentials in production)
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Uploads (defaults to /app/backend/uploads inside Docker)
UPLOAD_DIR=backend/uploads
STATIC_URL_PREFIX=/uploads

# Model warm-up (disable on Railway to avoid cold-start downloads)
WARMUP_MODELS_ENABLED=false

# Background removal model (u2netp = 4 MB, u2net = larger)
REMBG_MODEL=u2netp


# ── LLM Providers ──────────────────────────────────────────────
# Groq Cloud (primary LLM for chat, cataloging, pricing)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq

# Google Gemini (fallback LLM + embeddings + pricing)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001


# ── Voice / Speech-to-Text ─────────────────────────────────────
# Any OpenAI-compatible transcription endpoint works.
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-large-v3
STT_PROVIDER=whisper
DEFAULT_LANGUAGE=hi
SUPPORTED_LANGUAGES=hi,ta,bn,mr,te,gu,kn,ml,pa,or
STT_REQUEST_TIMEOUT=60
STT_RETRY_ATTEMPTS=3
MAX_AUDIO_DURATION_SECONDS=180
GLOSSARY_TERMS_IN_PROMPT=24


# ── Bhashini Language Services (optional) ──────────────────────
# Uses the ULCA pipeline: config call + compute call.
# Without credentials, Bhashini endpoints return 503.
BHASHINI_API_KEY=<your-bhashini-api-key>
BHASHINI_USER_ID=<your-bhashini-user-id>
# Deprecated: the new ULCA client does not use this value.
# Kept here only for backward compatibility with older code.
BHASHINI_BASE_URL=https://api.bhashini.gov.in


# ── ChromaDB / Pricing Pipeline ────────────────────────────────
# Path to ChromaDB persistent storage directory.
CHROMADB_PATH=ML/pricing/chroma_db
CHROMADB_COLLECTION=benchmark_products
PRICING_TOP_K=5
PRICING_SIMILARITY_THRESHOLD=0.55


# ── Optional: Supabase (not used by current backend code) ───────
# The current backend uses SQLAlchemy + PostgreSQL/SQLite directly.
# Supabase is NOT required for Craftsy to run.


# ── Railway (set in Railway dashboard, not in this file) ────────
# DATABASE_URL  — Railway PostgreSQL connection string
# ENVIRONMENT   — production
# CORS_ORIGINS  — your production frontend domain(s)
# GROQ_API_KEY  — if using Groq
# GEMINI_API_KEY — if using Gemini
# WHISPER_API_KEY — if using Whisper STT
# BHASHINI_API_KEY, BHASHINI_USER_ID — if using Bhashini
